{
  "name": "@ddlbuilder/worker",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build --config vite.config.ts",
    "dev": "pnpm --dir ../.. run dev:worker",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "oxlint --config ../../.oxlintrc.json --type-aware --tsconfig tsconfig.json api/ server-api/ && oxfmt --config ../../.oxfmtrc.json --check api/ server-api/",
    "lint:fix": "oxlint --config ../../.oxlintrc.json --type-aware --tsconfig tsconfig.json --fix api/ server-api/ && oxfmt --config ../../.oxfmtrc.json --write api/ server-api/",
    "format": "oxfmt --config ../../.oxfmtrc.json --write api/ server-api/"
  },
  "dependencies": {
    "@ddlbuilder/ddl-core": "workspace:*",
    "@ddlbuilder/shared-types": "workspace:*",
    "@ddlbuilder/user-db": "workspace:*",
    "@ddlbuilder/workspace-core": "workspace:*",
    "better-auth": "^1.7.1",
    "drizzle-orm": "^0.45.2",
    "effect": "4.0.0-rc.112",
    "evlog": "2.27.1",
    "hono": "^4.13.3",
    "lib0": "^0.2.117",
    "openai": "^7.5.0",
    "resend": "^6.21.0",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.32"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260820.1",
    "@ddlbuilder/tsconfig": "workspace:*",
    "typescript": "~7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "wrangler": "^4.124.0"
  }
}
