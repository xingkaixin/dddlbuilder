{
  "name": "@ddlbuilder/worker",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build --config vite.config.ts",
    "dev": "wrangler dev api/index.ts --inspector-port 0 --persist-to ../../.wrangler/state/dev",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "oxlint --config ../../.oxlintrc.json --type-aware --tsconfig tsconfig.json api/ server-api/ && oxfmt --config ../../.oxfmtrc.json --check api/ server-api/",
    "lint:fix": "oxlint --config ../../.oxlintrc.json --type-aware --tsconfig tsconfig.json --fix api/ server-api/ && oxfmt --config ../../.oxfmtrc.json --write api/ server-api/",
    "format": "oxfmt --config ../../.oxfmtrc.json --write api/ server-api/"
  },
  "dependencies": {
    "@ddlbuilder/db": "workspace:*",
    "@ddlbuilder/shared-types": "workspace:*",
    "better-auth": "^1.6.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.9",
    "lib0": "^0.2.117",
    "openai": "^6.33.0",
    "resend": "^6.10.0",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.30"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250317.0",
    "@ddlbuilder/tsconfig": "workspace:*",
    "typescript": "~6.0.2",
    "vite": "^8.0.3",
    "vitest": "^4.1.4",
    "wrangler": "^4.86.0"
  }
}
