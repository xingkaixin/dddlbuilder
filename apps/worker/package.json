{
  "name": "@ddlbuilder/worker",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build --config vite.config.ts",
    "dev": "wrangler dev --inspector-port 0 --persist-to ../../.wrangler/state/dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ddlbuilder/db": "workspace:*",
    "@ddlbuilder/shared-types": "workspace:*",
    "better-auth": "*",
    "hono": "*",
    "drizzle-orm": "*",
    "openai": "*",
    "resend": "*",
    "jose": "*",
    "uuid": "*"
  },
  "devDependencies": {
    "@ddlbuilder/tsconfig": "workspace:*",
    "@cloudflare/workers-types": "*",
    "typescript": "*",
    "vite": "*",
    "wrangler": "*",
    "@better-auth/drizzle-adapter": "*"
  }
}
