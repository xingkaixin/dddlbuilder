---
import { docsHref, LOCALES, type LocaleKey } from '../lib/site';

interface Props {
  locale: LocaleKey;
}

const { locale } = Astro.props;
---

<a class="brand" href={docsHref(`/${locale}/`)}>
  <img src={docsHref('/logo.png')} alt="" width="32" height="32" />
  <span>{LOCALES[locale].brand}</span>
</a>
