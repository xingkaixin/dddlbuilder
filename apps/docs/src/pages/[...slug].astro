---
import type { GetStaticPaths } from 'astro';
import DocPage from '../components/DocPage.astro';
import { getDocs } from '../lib/docs';
import { routeOf } from '../lib/site';

export const getStaticPaths = (async () => {
  const docs = await getDocs();
  const routes = new Set(docs.map((entry) => routeOf(entry.id)));

  return docs
    .filter((entry) => !entry.id.endsWith('index'))
    .map((entry) => ({ params: { slug: entry.id }, props: { entry, routes } }));
}) satisfies GetStaticPaths;

const { entry, routes } = Astro.props;
---

<DocPage entry={entry} routes={routes} />
