---
import DocsLayout from '../layouts/DocsLayout.astro';
import { docsHref, LOCALES } from '../lib/site';

const copy = LOCALES.zh;
---

<DocsLayout locale="zh" title={`404 | ${copy.title}`} description="Not Found">
  <div class="hero" slot="banner">
    <h1>{copy.notFoundTitle}</h1>
    <p>{copy.notFoundBody}</p>
  </div>
  <main class="prose home">
    <p><a href={docsHref('/zh/')}>{copy.notFoundLink}</a></p>
  </main>
</DocsLayout>
