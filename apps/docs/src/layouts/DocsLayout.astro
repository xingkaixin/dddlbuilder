---
import '@ddlbuilder/design/tokens.css';
import '@ddlbuilder/design/sketch.css';
import '../fonts/roboto-mono/fonts.css';
import '../styles/icons.css';
import '../styles/docs.css';
import Brand from '../components/Brand.astro';
import { APP_URL, docsHref, FEEDBACK_URL, LOCALE_KEYS, LOCALES, type LocaleKey } from '../lib/site';
import DocsHead from './DocsHead.astro';

interface Props {
  locale: LocaleKey;
  title: string;
  description: string;
  route?: string;
  alternates?: { lang: string; route: string }[];
}

const { locale, title, description, route = '', alternates = [] } = Astro.props;
const copy = LOCALES[locale];
const changelogRoute = `/${locale}/changelog/changelog`;
const languages = LOCALE_KEYS.map((key) => {
  const alternate = alternates.find((entry) => entry.lang === LOCALES[key].lang);

  return { key, label: LOCALES[key].label, href: docsHref(alternate?.route ?? `/${key}/`) };
});
---

<!doctype html>
<html lang={copy.lang} dir="ltr">
  <head>
    <DocsHead title={title} description={description}><slot name="head" /></DocsHead>
  </head>
  <body data-lang={locale} data-copy={copy.copyCode} data-copied={copy.copied}>
    <div class="float">
      <div class="float__in">
        <Brand locale={locale} />
        <span class="spacer"></span>
        <button class="icon-btn search-icon" type="button" aria-label={copy.search} data-search-open>
          <i class="i i-search" aria-hidden="true"></i>
        </button>
        <a class="lm-btn lm-btn--primary lm-btn--sm" href={APP_URL} data-sketch="wash">{copy.open}</a>
      </div>
    </div>
    <header class="doc__banner">
      <div class="doc__top">
        <Brand locale={locale} />
        <nav class="nav" aria-label={copy.navLabel}>
          <a href={docsHref(`/${locale}/`)} aria-current={route && route !== changelogRoute ? 'page' : undefined}>
            {copy.docs}
          </a>
          <a href={docsHref(changelogRoute)} aria-current={route === changelogRoute ? 'page' : undefined}>
            {copy.changelog}
          </a>
        </nav>
        <span class="spacer"></span>
        <button class="icon-btn search-icon" type="button" aria-label={copy.search} data-search-open>
          <i class="i i-search" aria-hidden="true"></i>
        </button>
        <details class="lang">
          <summary class="icon-btn" aria-label={copy.language}>
            <i class="i i-globe" aria-hidden="true"></i>
          </summary>
          <div class="lang__menu">
            {
              languages.map((language) => (
                <a href={language.href} aria-current={language.key === locale ? 'true' : undefined}>
                  {language.label}
                </a>
              ))
            }
          </div>
        </details>
        <button class="icon-btn" type="button" aria-label={copy.themeToggle} data-theme-toggle>
          <i class="i i-moon" aria-hidden="true"></i>
          <i class="i i-sun" aria-hidden="true"></i>
        </button>
        <a class="lm-btn lm-btn--primary lm-btn--sm hide-phone" href={APP_URL} data-sketch="wash">{copy.open}</a>
      </div>
      <slot name="banner" />
    </header>
    <slot />
    <footer class="foot">
      <div class="foot__in">
        <span>{copy.brand}</span>
        <a href={FEEDBACK_URL} target="_blank" rel="noreferrer">{copy.feedback}</a>
      </div>
    </footer>
    <dialog class="search" data-search-dialog data-empty={copy.searchEmpty} data-failed={copy.searchFailed}>
      <input type="search" aria-label={copy.search} placeholder={copy.searchPlaceholder} />
      <ul></ul>
    </dialog>
    <script>
      import '../scripts/site';
      import '../scripts/sketch';
    </script>
  </body>
</html>
