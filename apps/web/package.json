{
  "name": "@ddlbuilder/web",
  "version": "0.26.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host localhost --port 3000 --strictPort",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
