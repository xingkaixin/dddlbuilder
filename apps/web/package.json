{
  "name": "@ddlbuilder/web",
  "version": "0.21.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host localhost --port 3000 --strictPort",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "lint": "oxlint --config ../../.oxlintrc.json --type-aware --tsconfig tsconfig.json --deny-warnings src/ && oxfmt --config ../../.oxfmtrc.json --check src/",
    "lint:fix": "oxlint --config ../../.oxlintrc.json --type-aware --tsconfig tsconfig.json --fix src/ && oxfmt --config ../../.oxfmtrc.json --write src/",
    "format": "oxfmt --config ../../.oxfmtrc.json --write src/"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@ddlbuilder/ddl-core": "workspace:*",
    "@ddlbuilder/shared-types": "workspace:*",
    "@ddlbuilder/workspace-core": "workspace:*",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hugeicons/core-free-icons": "4.3.0",
    "@hugeicons/react": "1.1.9",
    "@number-flow/react": "^0.6.2",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-table": "^9.1.2",
    "@xyflow/react": "^12.11.3",
    "better-auth": "^1.7.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "0.8.3",
    "i18next": "^26.4.0",
    "lib0": "^0.2.117",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.12",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "y-indexeddb": "^9.0.12",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.32",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@ddlbuilder/tsconfig": "workspace:*",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.5.4",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.26",
    "tailwindcss": "4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "webmcp-types": "^0.1.5"
  }
}
