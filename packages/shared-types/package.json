{
  "name": "@ddlbuilder/shared-types",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./api": "./src/api.ts",
    "./workspace": "./src/workspace.ts",
    "./locale": "./src/locale.ts",
    "./ai-generate": "./src/aiGenerate.ts",
    "./ddl-review": "./src/ddlReview.ts",
    "./api-contracts": "./src/apiContracts.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint --config ../../.oxlintrc.json --type-aware --tsconfig tsconfig.json src/ && oxfmt --config ../../.oxfmtrc.json --check src/",
    "lint:fix": "oxlint --config ../../.oxlintrc.json --type-aware --tsconfig tsconfig.json --fix src/ && oxfmt --config ../../.oxfmtrc.json --write src/",
    "format": "oxfmt --config ../../.oxfmtrc.json --write src/"
  },
  "dependencies": {
    "effect": "4.0.0-rc.113"
  },
  "devDependencies": {
    "@ddlbuilder/tsconfig": "workspace:*"
  }
}
