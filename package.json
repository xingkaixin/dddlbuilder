{
  "name": "ddlbuilder",
  "private": true,
  "version": "0.14.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b tsconfig.build.json && vite build",
    "start": "bun run server.ts",
    "changelog": "bun run src/scripts/parseChangelog.ts",
    "logo": "bun run scripts/generate-logos.ts && bun run scripts/generate-favicon.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --fix .",
    "lint:format": "biome format .",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "bunx playwright show-report"
  },
  "dependencies": {
    "@hono/vite-dev-server": "^0.25.0",
    "@number-flow/react": "^0.5.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
