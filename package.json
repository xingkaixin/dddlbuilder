{
  "name": "ddlbuilder",
  "version": "0.15.7",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "dev:app": "vite --host localhost --port 3000 --strictPort",
    "dev:worker": "bun run scripts/dev-worker.ts",
    "db:migrate:local": "bun run scripts/d1-migrate.ts",
    "db:migrate:remote": "bun run scripts/d1-migrate.ts --remote",
    "db:seed:local": "bun run scripts/d1-seed.ts",
    "db:seed:remote": "bun run scripts/d1-seed.ts --remote",
    "db:reset:local": "bun run scripts/d1-reset.ts",
    "db:inspect:local": "bun run scripts/d1-inspect.ts",
    "db:inspect:remote": "bun run scripts/d1-inspect.ts --remote",
    "dev:docs": "bun run docs:dev",
    "build:wrangler-dev": "tsc -b tsconfig.build.json && vite build --config vite.config.server.ts && vite build",
    "build": "tsc -b tsconfig.build.json && vite build --config vite.config.server.ts && bun run scripts/verify-server-bundle.ts && vite build && bun run docs:build && cp -r dist/docs dist/client/",
    "docs:dev": "bun run --cwd docs docs:dev",
    "docs:build": "bun install --cwd docs && bun run --cwd docs docs:build",
    "docs:preview": "bun run --cwd docs docs:preview",
    "start": "bun run server.ts",
    "e2e:serve": "mkdir -p .wrangler-home/Library/Preferences/.wrangler/logs .wrangler/state/e2e && HOME=\"$PWD/.wrangler-home\" ./node_modules/.bin/wrangler dev --config wrangler.e2e.toml --local --no-bundle --show-interactive-dev-session=false --persist-to .wrangler/state/e2e --ip 127.0.0.1 --port 3000 --inspector-port 0 --log-level error",
    "logo": "bun run scripts/generate-logos.ts && bun run scripts/generate-favicon.ts",
    "lint": "oxlint --type-aware --tsconfig tsconfig.oxlint.json . && oxfmt --check src server-api api scripts e2e server.ts vite.config.ts vite.config.server.ts vitest.config.ts playwright.config.ts package.json tsconfig.json tsconfig.app.json tsconfig.build.json tsconfig.node.json tsconfig.oxlint.json .oxlintrc.json .oxfmtrc.json",
    "lint:fix": "oxlint --type-aware --tsconfig tsconfig.oxlint.json --fix . && oxfmt --write src server-api api scripts e2e server.ts vite.config.ts vite.config.server.ts vitest.config.ts playwright.config.ts package.json tsconfig.json tsconfig.app.json tsconfig.build.json tsconfig.node.json tsconfig.oxlint.json .oxlintrc.json .oxfmtrc.json",
    "lint:format": "oxfmt --write src server-api api scripts e2e server.ts vite.config.ts vite.config.server.ts vitest.config.ts playwright.config.ts package.json tsconfig.json tsconfig.app.json tsconfig.build.json tsconfig.node.json tsconfig.oxlint.json .oxlintrc.json .oxfmtrc.json",
    "preview": "vite preview",
    "test:watch": "vitest",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "bunx playwright show-report",
    "deploy": "bun run build && wrangler deploy --config wrangler.deploy.toml"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.6.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hono/vite-dev-server": "^0.25.0",
    "@number-flow/react": "^0.6.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@supabase/supabase-js": "^2.103.0",
    "@tanstack/react-query": "^5.95.2",
    "@tanstack/react-table": "^8.21.3",
    "better-auth": "^1.6.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.9",
    "i18next": "^25.10.10",
    "jose": "^6.2.2",
    "lucide-react": "^1.7.0",
    "lz-string": "^1.5.0",
    "next-themes": "^0.4.6",
    "node-sql-parser": "^5.4.0",
    "openai": "^6.33.0",
    "png-to-ico": "^3.0.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-i18next": "^16.6.6",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "remark-gfm": "^4.0.1",
    "resend": "^6.10.0",
    "sharp": "^0.34.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "uuid": "^13.0.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.21",
    "@cloudflare/workers-types": "^4.20250317.0",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.2",
    "@vitest/ui": "^4.1.2",
    "autoprefixer": "^10.4.27",
    "drizzle-kit": "^0.31.10",
    "gray-matter": "^4.0.3",
    "jsdom": "^29.0.1",
    "oxfmt": "^0.43.0",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^0.18.1",
    "postcss": "^8.5.8",
    "tailwindcss": "4.2.2",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~6.0.2",
    "vite": "^8.0.3",
    "vitest": "^4.1.2",
    "wrangler": "^4.78.0"
  },
  "overrides": {
    "mdast-util-to-hast": "^13.2.1"
  }
}
