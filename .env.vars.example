OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=your-api-key
OPENAI_MODEL_NAME=gpt-4o-mini
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000
AUTH_REQUIRE_EMAIL_VERIFICATION=true
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM_EMAIL=noreply@example.com
RESEND_FROM_NAME=DDLBuilder
TURNSTILE_SECRET_KEY=your-turnstile-secret
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key
SIGNUP_BONUS_CREDITS=100000
VITE_BETTER_AUTH_URL=http://localhost:3000

# OpenAI retry policy
OPENAI_RETRY_MAX_ATTEMPTS=3
OPENAI_RETRY_BASE_DELAY_MS=400
OPENAI_RETRY_MAX_DELAY_MS=3000

# OpenAI rate limit policy (anonymous fingerprint: IP + UA + route)
OPENAI_RATELIMIT_ENABLED=true
OPENAI_RATELIMIT_WINDOW_MS=60000
OPENAI_RATELIMIT_EXPLAIN_MAX=15
OPENAI_RATELIMIT_REVIEW_MAX=6
OPENAI_RATELIMIT_GENERATE_MAX=4
# OpenAI daily budget policy (global)
OPENAI_DAILY_BUDGET_ENABLED=false
OPENAI_DAILY_BUDGET_MAX_TOKENS=500000

# CSP policy rollout
# off | report-only | enforce | both
CSP_ENABLE=true
CSP_MODE=both
# Optional: override default CSP string
# CSP_POLICY=default-src 'self'; ...

# Seasonal UI
VITE_ENABLE_CNY_FIREWORKS=false


# telegram
TELEGRAM_NOTIFY_ENABLED=false
TELEGRAM_BOT_TOKEN="tg bot token"
TELEGRAM_CHAT_ID="tg id"
